^\[main\.p1\] always main\.w == \{ main\.x, 2'b10, 2'b01 \}: PROVED up to bound 1$
^\[main\.p2\] always main\.v\[5:4\] == 2'b00: REFUTED$
^EXIT=10$
^SIGNAL=0$
