CORE
enum_single_bit1.sv
--bound 3
^\[main\.p0\] always .*: PROVED up to bound 3$
^\[main\.p1\] always .*: PROVED up to bound 3$
^\[main\.p2\] always .*: PROVED up to bound 3$
^\[main\.p3\] always main\.b != main\.B1: REFUTED$
^EXIT=10$
^SIGNAL=0$
