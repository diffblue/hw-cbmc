CORE
onehot2.sv
--bound 2
^\[main\.assume\.1\] always \$onehot0\(main\.x\): ASSUMED$
^\[main\.p0\] always !\(main\.x\[0\] && main\.x\[1\]\): PROVED up to bound 2$
^\[main\.p1\] always \$countones\(main\.x\) <= 1: PROVED up to bound 2$
^\[main\.p2\] always main\.x != 0: REFUTED$
^\[main\.p3\] always main\.x != 4'b0100: REFUTED$
^EXIT=10$
^SIGNAL=0$
--
^warning: ignoring
