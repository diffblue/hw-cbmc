CORE
gated_clock_instance1.sv
--bound 6
^\[main\.p_hold\] .*: PROVED up to bound 6$
^\[main\.p_low\] .*: PROVED up to bound 6$
^\[main\.p_high\] .*: PROVED up to bound 6$
^\[main\.p_high_hold\] .*: PROVED up to bound 6$
^EXIT=0$
^SIGNAL=0$
