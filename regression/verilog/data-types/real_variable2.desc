CORE
real_variable2.sv
--bound 3 --trace
^\[main\.p0\] always main\.r >= 1\.5: PROVED up to bound 3$
^\[main\.p1\] always main\.r < 3: REFUTED$
^  main\.r = 1\.5$
^  main\.r = 2\.5$
^  main\.r = 3\.5$
^EXIT=10$
^SIGNAL=0$
--
^warning: ignoring
