CORE
parameter8.sv
--bound 1
^\[main\.s\[0\]\.p0\] always \$bits\(main\.s\[0\]\.s\.a\) == 4: PROVED up to bound 1$
^\[main\.s\[0\]\.p1\] always main\.s\[0\]\.s\.a == 4'b0101: PROVED up to bound 1$
^\[main\.s\[0\]\.p2\] always .*: PROVED up to bound 1$
^\[main\.s\[1\]\.p0\] always \$bits\(main\.s\[1\]\.s\.a\) == 4: PROVED up to bound 1$
^\[main\.s\[1\]\.p1\] always main\.s\[1\]\.s\.a == 4'b0101: PROVED up to bound 1$
^\[main\.s\[1\]\.p2\] always .*: PROVED up to bound 1$
^EXIT=0$
^SIGNAL=0$
--
^warning: ignoring
--
The interface types of the interface ports are those of every element of
an array of module instances.
