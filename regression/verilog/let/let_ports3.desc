CORE
let_ports3.sv
--bound 5
^\[main\.p0\] always main\.x \+ main\.y == main\.x \+ main\.y: PROVED up to bound 5$
^\[main\.p1\] always main\.b - main\.a == main\.x - main\.y: PROVED up to bound 5$
^\[main\.p2\] always main\.y - main\.x == main\.y - main\.x: PROVED up to bound 5$
^\[main\.p3\] always main\.x - main\.y \+ main\.y == main\.x: PROVED up to bound 5$
^\[main\.p4\] .* PROVED up to bound 5$
^\[main\.p5\] .* REFUTED$
^EXIT=10$
^SIGNAL=0$
--
^warning: ignoring
