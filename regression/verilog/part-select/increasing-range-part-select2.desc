^\[main\.p2\] always \(##1 main\.v\[7:4\] == 4'b0000\): PROVED up to bound 1$
^\[main\.p3\] always \(##1 main\.u == 12\): PROVED up to bound 1$
^\[main\.p4\] always \(##1 main\.u\[8\+:2\] == 2'b11\): PROVED up to bound 1$
^EXIT=0$
^SIGNAL=0$
